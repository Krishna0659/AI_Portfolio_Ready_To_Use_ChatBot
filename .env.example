APP_ORIGIN=http://localhost:3000
LOCAL_DEVELOPMENT_LOGIN=false
DATABASE_URL=postgresql://portfolio_runtime:REPLACE@127.0.0.1:55432/postgres
IDENTITY_DATABASE_URL=postgresql://portfolio_identity:REPLACE@127.0.0.1:55432/postgres
WORKER_DATABASE_URL=postgresql://portfolio_worker:REPLACE@127.0.0.1:55432/postgres
ADMIN_DATABASE_URL=postgresql://portfolio_admin:REPLACE@127.0.0.1:55432/postgres
RUNTIME_DB_PASSWORD=REPLACE_WITH_48_HEX_CHARACTERS
PYTHON_PATH=python
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OIDC_FLOW_KEY=REPLACE_WITH_64_HEX_CHARACTERS
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_OWNER_WORKSPACE_ID=
# Optional server-side RAG generation. Never use a NEXT_PUBLIC_ key variable.
# Alternatively, store only the key in ignored .local/gemini-key.txt.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY_FILE=.local/gemini-key.txt
# Server-only website-to-RAG bridge. Use an absolute Python executable path.
RAG_PYTHON=python
RAG_KB_URL=http://127.0.0.1:18080
RAG_KB_API_KEY=
# KB container path to pinned local cross-encoder weights (included in the KB image).
KB_RERANKER_PATH=/opt/reranker-model
# Set to 1 to stop RAG retrieval/generation while investigating a release.
RAG_GENERATION_DISABLED=0
# Opt-in server-side operational tracing; raw prompts/content are never captured.
RAG_LANGSMITH_ENABLED=0
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=portfolioai-rag
RAG_TRACE_SAMPLE_RATE=0.01

# Public SEO: configure only when the public site is ready to launch.
SITE_URL=
SEO_INDEXABLE=false
